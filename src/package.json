{
  "name": "bitshadow-pro",
  "version": "2.0.0",
  "description": "Ferramenta Profissional de Esteganografia AES-256",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "author": "Teu Nome",
  "license": "ISC",
  "devDependencies": {
    "electron": "28.2.0",
    "electron-builder": "24.13.3"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  },
  "build": {
    "appId": "com.bitshadow.pro",
    "productName": "BitShadow Pro",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BitShadow Pro",
      "installerIcon": "src/icon.ico",
      "uninstallerIcon": "src/icon.ico",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "files": [
      "main.js",
      "index.html",
      "indexPro.html",
      "icon.ico",
      "icon.png",
      "node_modules/**/*"
    ]
  }
}
